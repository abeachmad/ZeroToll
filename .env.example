# ZeroToll Environment Configuration
# Copy this to .env and fill in your values

# ==========================================
# DEPLOYER PRIVATE KEY (REQUIRED)
# ==========================================
# WARNING: Never commit this file with real private key!
# Get testnet ETH from faucets:
# - Sepolia: https://sepoliafaucet.com/
# - Amoy: https://faucet.polygon.technology/
# - Arbitrum Sepolia: https://faucet.quicknode.com/arbitrum/sepolia
# - Optimism Sepolia: https://app.optimism.io/faucet

PRIVATE_KEY_DEPLOYER=your_private_key_here_without_0x_prefix

# ==========================================
# RPC ENDPOINTS (Optional - defaults provided)
# ==========================================
RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_AMOY=https://rpc-amoy.polygon.technology
RPC_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
RPC_OPTIMISM_SEPOLIA=https://sepolia.optimism.io

# ==============================================
# BLOCK EXPLORER API KEYS (For Verification)
# ==============================================
# ✨ NEW: Etherscan V2 Unified API (August 2024+)
# ONE API key works for ALL chains via chainid parameter!
# Get free API key from: https://etherscan.io/myapikey
#
# Supported chains with single key:
# - Ethereum (chainid=1), Sepolia (11155111)
# - Polygon (chainid=137), Amoy (80002)  
# - Arbitrum (chainid=42161), Arbitrum Sepolia (421614)
# - Optimism (chainid=10), Optimism Sepolia (11155420)
# - Base, BNB Chain, Avalanche, and 60+ more chains
#
# Learn more: https://docs.etherscan.io/v2-migration

ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Legacy separate keys (DEPRECATED - no longer needed with V2)
# POLYGONSCAN_API_KEY=not_needed_anymore
# ARBISCAN_API_KEY=not_needed_anymore  
# OPTIMISTIC_ETHERSCAN_API_KEY=not_needed_anymore

# ==============================================
# DEPLOYED CONTRACT ADDRESSES
# ==============================================

# ==========================================
# TREASURY ADDRESS (Optional)
# ==========================================
# Where fees will be sent. Defaults to deployer address if not set
TREASURY_ADDRESS=

# ==========================================
# ENTRYPOINT ADDRESSES (ERC-4337)
# ==========================================
# Default: 0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789 (same on all testnets)
ENTRYPOINT_SEPOLIA=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
ENTRYPOINT_AMOY=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
ENTRYPOINT_ARBITRUM_SEPOLIA=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
ENTRYPOINT_OPTIMISM_SEPOLIA=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
MONGODB_URI=mongodb://localhost:27017/zerotoll
PORT=8000

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
REACT_APP_API_URL=http://localhost:8000

# ==========================================
# ZEROTOLL ROUTER ADDRESSES (Updated Dec 4, 2025)
# ==========================================
# Sepolia (chainId: 11155111)
ZEROTOLL_ROUTER_SEPOLIA=0x577560699EF88e99f15d04df57c9552056d2a10D
ZEROTOLL_ADAPTER_SEPOLIA=0x5c2d8Ce29Bb6E5ddf14e8df5a62ec78AAeffBffa

# Amoy (chainId: 80002)
ZEROTOLL_ROUTER_AMOY=0xc75df1943d6EFE04b422b9bB45509782609Fc67a
ZEROTOLL_ADAPTER_AMOY=0x8Bf6f17F19CAc8b857764E9B97E7B8FdCE194e84

# ==========================================
# ZEROTOLL zTOKENS (ERC-2612 Permit)
# ==========================================
# Sepolia zTokens
ZUSDC_SEPOLIA=0x5F43D1Fc4fAad0dFe097fc3bB32d66a9864c730C
ZETH_SEPOLIA=0x8153FA09Be1689D44C343f119C829F6702A8720b
ZPOL_SEPOLIA=0x63c31C4247f6AA40B676478226d6FEB5707649D6
ZLINK_SEPOLIA=0x4e2dbcCc07D8e5a8C9f420ea60d1e3aEc7B64D2C

# Amoy zTokens
ZUSDC_AMOY=0x257Fb36CD940D1f6a0a4659e8245D3C3FCecB8bD
ZETH_AMOY=0xfAE5Fb760917682d67Bc2082667C2C5E55A193f9
ZPOL_AMOY=0xB0A04aB21faAe4A5399938c07EDdfA0FB41d2B9d
ZLINK_AMOY=0x51f6c79e5cA4ACF086d0954AfAAf5c72Be56CBb1

# ==========================================
# PHASE 2: SELF-HOSTED PAYMASTER STACK
# ==========================================

# Relayer private key (signs UserOps, pays gas in relayer mode)
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# Policy signer (signs UserOps for VerifyingPaymaster)
# Can be same as relayer or separate key for security
POLICY_SIGNER_PRIVATE_KEY=your_policy_signer_key_here
POLICY_SIGNER_ADDRESS=0x_your_policy_signer_address

# Pimlico API key (for Pimlico mode fallback)
PIMLICO_API_KEY=your_pimlico_api_key_here

# ==========================================
# VERIFYING PAYMASTER ADDRESSES (Phase 2)
# ==========================================
# Deploy with: npx hardhat run scripts/deploy-verifying-paymaster.js --network <network>
SEPOLIA_VERIFYING_PAYMASTER=
AMOY_VERIFYING_PAYMASTER=

# ==========================================
# INFINITISM BUNDLER URLS (Phase 2)
# ==========================================
# Run bundler locally or use hosted service
BUNDLER_SEPOLIA_URL=http://localhost:3000/rpc
BUNDLER_AMOY_URL=http://localhost:3001/rpc

# ==========================================
# GAS TANK MONITOR (Phase 2)
# ==========================================
# Wallet that funds paymasters (can be same as relayer)
GAS_TANK_PRIVATE_KEY=your_gas_tank_key_here

# Discord/Telegram webhook for alerts (optional)
ALERT_WEBHOOK_URL=

# HTTP port for gas tank status endpoint (optional)
GAS_TANK_HTTP_PORT=3003

# ==========================================
# RELAYER PORTS
# ==========================================
RELAYER_PORT=3001
SELF_HOSTED_RELAYER_PORT=3002
