REACT_APP_BACKEND_URL=http://localhost:8000
WDS_SOCKET_PORT=3000

# Web3 Configuration
REACT_APP_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
REACT_APP_RPC_AMOY=https://rpc-amoy.polygon.technology/
REACT_APP_RPC_SEPOLIA=https://rpc.sepolia.org

# Pyth Configuration
REACT_APP_PYTH_HERMES_URL=https://hermes.pyth.network

# ============================================
# INTENT-BASED GASLESS (Pimlico Relayer)
# ============================================
REACT_APP_RELAYER_URL=http://localhost:3002

# ZeroToll Router V2 (Updated Dec 4, 2025)
REACT_APP_ZEROTOLL_ROUTER_SEPOLIA=0x577560699EF88e99f15d04df57c9552056d2a10D
REACT_APP_ZEROTOLL_ROUTER_AMOY=0xc75df1943d6EFE04b422b9bB45509782609Fc67a

# ============================================
# EIP-7702 CONFIGURATION
# ============================================
REACT_APP_PIMLICO_API_KEY=your_pimlico_api_key
REACT_APP_BUNDLER_RPC_AMOY=https://api.pimlico.io/v2/80002/rpc?apikey=YOUR_KEY
REACT_APP_BUNDLER_RPC_SEPOLIA=https://api.pimlico.io/v2/11155111/rpc?apikey=YOUR_KEY
REACT_APP_PAYMASTER_RPC_AMOY=https://api.pimlico.io/v2/80002/rpc?apikey=YOUR_KEY
REACT_APP_PAYMASTER_RPC_SEPOLIA=https://api.pimlico.io/v2/11155111/rpc?apikey=YOUR_KEY
REACT_APP_ENABLE_EIP7702=true
REACT_APP_ENABLE_GASLESS=true
